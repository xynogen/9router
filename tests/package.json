{
  "name": "9router-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Unit tests for 9router embeddings endpoint",
  "scripts": {
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --test unit/cline-auth.test.js unit/kimchi.test.js unit/kimchi-strip-reasoning.test.js auth/saml.test.js",
    "test:vitest": "vitest run --reporter=verbose",
    "test:watch": "vitest --reporter=verbose"
  },
  "devDependencies": {
    "lowdb": "^7.0.1",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=22.15"
  }
}
